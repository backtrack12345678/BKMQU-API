// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String                  @id @db.VarChar(150)
  phone        String                  @unique @db.VarChar(20)
  password     String                  @db.VarChar(100)
  email        String                  @unique @db.VarChar(200)
  role         String                  @db.VarChar(10)
  isVerified   Boolean                 @default(false) @map("is_verified")
  acceptTerm   Boolean?                @map("accept_term")
  createdAt    DateTime                @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt    DateTime?               @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime
  mesjid       Mesjid?
  pengurus     Pengurus?
  jamaah       Jamaah?
  penceramah   Penceramah?
  refreshToken Refresh_Token?
  dokumenBukti Dokumen_Bukti?
  detailUser   Detail_User?
  posts        Posts[]
  aktivitas    Aktivitas[]
  recipient    Midtrans_Transactions[] @relation("recipient")
  userInfaq    User_Infaq[]
  userSedekah  User_Sedekah[]
  kajian       Kajian[]
  photo        Photo_User?
  sampul       Sampul_User?
  live         Live[]
  userBank     User_Bank[]
  podcast      Podcast[]

  @@map("user")
}

model Detail_User {
  id           Int            @id @default(autoincrement())
  userId       String         @unique @map("user_id") @db.VarChar(150)
  user         User           @relation(fields: [userId], references: [id])
  nama         String         @db.VarChar(200)
  tanggalLahir DateTime?      @map("tanggal_lahir")
  status       String         @default("PENDING") @db.VarChar(10)
  kecamatanId  Int            @map("kecamatan_id")
  kecamatan    Kecamatan      @relation(fields: [kecamatanId], references: [id])
  kotaKabId    Int            @map("kota_kab_id")
  kota_kab     Kota_Kabupaten @relation(fields: [kotaKabId], references: [id])
  provinsiId   Int            @map("provinsi_id")
  provinsi     Provinsi       @relation(fields: [provinsiId], references: [id])
  alamat       String?        @db.Text
  saldo        BigInt         @default(0) @db.BigInt
  createdAt    DateTime       @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt    DateTime?      @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime

  @@map("detail_user")
}

model User_Bank {
  id         Int    @id @default(autoincrement())
  userId     String @map("user_id") @db.VarChar(150)
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankId     Int    @map("bank_id") @db.Int
  bank       Bank   @relation(fields: [bankId], references: [id], onDelete: Cascade)
  nama       String @db.VarChar(200)
  noRekening String @unique @db.VarChar(50)
  accountId  String @default("-") @map("account_id") @db.VarChar(200)
  status     String @default("PENDING") @db.VarChar(10)

  createdAt DateTime  @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt DateTime? @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime
  kasBank   Kas_Bank?

  @@map("user_bank")
}

model Photo_User {
  id        Int       @id @default(autoincrement())
  userId    String    @unique @map("user_id") @db.VarChar(150)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nama      String    @default("default_user.jpg") @db.VarChar(250)
  path      String    @db.Text
  createdAt DateTime  @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt DateTime? @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime

  @@map("photo_user")
}

model Sampul_User {
  id        Int       @id @default(autoincrement())
  userId    String    @unique @map("user_id") @db.VarChar(150)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nama      String    @default("default_sampul.jpg") @db.VarChar(250)
  path      String    @db.Text
  createdAt DateTime  @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt DateTime? @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime

  @@map("sampul_user")
}

model Mesjid {
  id              Int                @id @default(autoincrement())
  userId          String             @unique @map("user_id") @db.VarChar(150)
  user            User               @relation(fields: [userId], references: [id])
  noRegister      String             @unique @map("no_register") @db.VarChar(200)
  imam            String?            @db.VarChar(200)
  kasBankLimit    Int                @default(2) @db.Int
  pengurus        Pengurus[]
  jamaah          Jamaah[]
  kas             Kas[]
  dokumenQr       Dokumen_QR?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  infaq           Infaq[]
  penerimaSedekah Penerima_Sedekah[]
  transaksiMesjid Transaksi_Mesjid[]
  Kas_Mutasi      Kas_Mutasi[]

  @@map("mesjid")
}

model Pengurus {
  id            Int       @id @default(autoincrement())
  userId        String    @unique @map("user_id") @db.VarChar(150)
  user          User      @relation(fields: [userId], references: [id])
  jabatan       String    @db.VarChar(100)
  uraianJabatan String?   @map("uraian_jabatan") @db.VarChar(150)
  mesjidId      Int       @map("mesjid_id")
  mesjid        Mesjid    @relation(fields: [mesjidId], references: [id])
  createdAt     DateTime  @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt     DateTime? @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime

  @@map("pengurus")
}

model Jamaah {
  id        Int       @id @default(autoincrement())
  userId    String    @unique @map("user_id") @db.VarChar(150)
  user      User      @relation(fields: [userId], references: [id])
  mesjidId  Int       @map("mesjid_id")
  mesjid    Mesjid    @relation(fields: [mesjidId], references: [id])
  createdAt DateTime  @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt DateTime? @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime

  @@map("jamaah")
}

model Penceramah {
  id        Int       @id @default(autoincrement())
  userId    String    @unique @map("user_id") @db.VarChar(150)
  user      User      @relation(fields: [userId], references: [id])
  keahlian  String    @db.VarChar(100)
  createdAt DateTime  @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt DateTime? @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime

  @@map("penceramah")
}

model Otp {
  id          Int       @id @default(autoincrement())
  phone       String    @unique @db.VarChar(20)
  otp_hashed  String    @db.VarChar(150)
  expired_otp String    @db.VarChar(100)
  type        String    @db.VarChar(25)
  createdAt   DateTime  @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt   DateTime? @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime

  @@map("otp")
}

model Refresh_Token {
  id                Int       @id @default(autoincrement())
  userId            String    @unique @map("user_id") @db.VarChar(150)
  user              User      @relation(fields: [userId], references: [id])
  refreshToken      String    @map("refresh_token") @db.VarChar(250)
  notificationToken String?   @map("notification_token") @db.VarChar(250)
  createdAt         DateTime  @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt         DateTime? @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime

  @@map("refresh_token")
}

model Provinsi {
  id         Int              @id @default(autoincrement())
  kode       String           @db.VarChar(10)
  nama       String           @db.VarChar(200)
  kota_kab   Kota_Kabupaten[]
  kecamatan  Kecamatan[]
  createdAt  DateTime         @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt  DateTime?        @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime
  detailUser Detail_User[]

  @@map("provinsi")
}

model Kota_Kabupaten {
  id         Int           @id @default(autoincrement())
  provinsiId Int           @map("provinsi_id")
  provinsi   Provinsi      @relation(fields: [provinsiId], references: [id])
  kode       String        @db.VarChar(10)
  nama       String        @db.VarChar(150)
  createdAt  DateTime      @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt  DateTime?     @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime
  kecamatan  Kecamatan[]
  detailUser Detail_User[]

  @@map("kota_Kabupaten")
}

model Kecamatan {
  id         Int            @id @default(autoincrement())
  provinsiId Int            @map("provinsi_id")
  provinsi   Provinsi       @relation(fields: [provinsiId], references: [id])
  kotaKabId  Int            @map("kota_kab_id")
  kota_kab   Kota_Kabupaten @relation(fields: [kotaKabId], references: [id])
  kode       String         @unique @db.VarChar(10)
  nama       String         @db.VarChar(150)
  createdAt  DateTime       @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt  DateTime?      @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime
  detailUser Detail_User[]

  @@index([nama])
  @@map("kecamatan")
}

model Dokumen_Bukti {
  id        Int       @id @default(autoincrement())
  userId    String    @unique @map("user_id") @db.VarChar(250)
  user      User      @relation(fields: [userId], references: [id])
  nama      String    @db.VarChar(250)
  path      String    @db.Text
  createdAt DateTime  @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt DateTime? @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime

  @@map("dokumen_bukti")
}

model Dokumen_QR {
  id        Int       @id @default(autoincrement())
  mesjidId  Int       @unique @map("mesjid_id") @db.Int()
  mesjid    Mesjid    @relation(fields: [mesjidId], references: [id])
  nama      String    @db.VarChar(250)
  path      String    @db.Text
  createdAt DateTime  @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt DateTime? @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime

  @@map("dokumen_qr")
}

model Posts {
  id       String        @id @default(cuid())
  userId   String        @map("user_id") @db.VarChar(250)
  user     User          @relation(fields: [userId], references: [id])
  captions String?       @db.Text
  media    Posts_Media[]

  createdAt DateTime  @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt DateTime? @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime

  @@map("posts")
}

model Posts_Media {
  id     Int     @id @default(autoincrement())
  postId String  @map("post_id") @db.VarChar(100)
  post   Posts   @relation(fields: [postId], references: [id], onDelete: Cascade)
  nama   String  @db.VarChar(250)
  path   String  @db.Text
  type   String? @db.VarChar(100)

  createdAt DateTime  @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt DateTime? @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime

  @@map("posts_media")
}

model Aktivitas {
  id       String   @id @default(cuid())
  userId   String   @map("user_id") @db.VarChar(150)
  user     User     @relation(fields: [userId], references: [id])
  judul    String   @db.VarChar(100)
  captions String   @db.Text
  mulai    DateTime
  selesai  DateTime

  createdAt DateTime            @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt DateTime?           @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime
  media     Aktivitas_Media[]
  dokumen   Aktivitas_Dokumen[]

  @@map("aktivitas")
}

model Aktivitas_Media {
  id          Int       @id @default(autoincrement())
  aktivitasId String    @map("aktivitas_id") @db.VarChar(100)
  aktivitas   Aktivitas @relation(fields: [aktivitasId], references: [id], onDelete: Cascade)
  nama        String    @db.VarChar(250)
  path        String    @db.Text

  createdAt DateTime  @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt DateTime? @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime

  @@map("aktivitas_media")
}

model Aktivitas_Dokumen {
  id          Int       @id @default(autoincrement())
  aktivitasId String    @map("aktivitas_id") @db.VarChar(100)
  aktivitas   Aktivitas @relation(fields: [aktivitasId], references: [id], onDelete: Cascade)
  nama        String    @db.VarChar(250)
  path        String    @db.Text

  createdAt DateTime  @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt DateTime? @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime

  @@map("aktivitas_dokumen")
}

model Kajian {
  id        String @id @db.VarChar(150)
  userId    String @map("user_id") @db.VarChar(150)
  user      User   @relation(fields: [userId], references: [id])
  judul     String @db.VarChar(100)
  deskripsi String @db.Text()

  createdAt DateTime          @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt DateTime?         @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime
  thumbnail Kajian_Thumbnail?
  contents  Kajian_Konten[]

  @@map("kajian")
}

model Kajian_Thumbnail {
  id       Int    @id @default(autoincrement())
  kajianId String @unique @map("kajian_id") @db.VarChar(150)
  kajian   Kajian @relation(fields: [kajianId], references: [id], onDelete: Cascade)
  nama     String @db.VarChar(250)
  path     String @db.Text

  createdAt DateTime  @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt DateTime? @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime

  @@map("kajian_thumbnail")
}

model Kajian_Konten {
  id       String @id @default(cuid())
  kajianId String @map("kajian_id") @db.VarChar(150)
  kajian   Kajian @relation(fields: [kajianId], references: [id], onDelete: Cascade)
  judul    String @db.VarChar(100)
  captions String @db.Text

  createdAt DateTime                 @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt DateTime?                @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime
  media     Kajian_Konten_Media?
  thumbnail Kajian_Konten_Thumbnail?

  @@map("kajian_konten")
}

model Kajian_Konten_Media {
  id             Int           @id @default(autoincrement())
  kajianKontenId String        @unique @map("kajian_konten_id") @db.VarChar(100)
  kajianKonten   Kajian_Konten @relation(fields: [kajianKontenId], references: [id], onDelete: Cascade)
  nama           String        @db.VarChar(250)
  path           String        @db.Text

  createdAt DateTime  @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt DateTime? @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime

  @@map("kajian_konten_media")
}

model Kajian_Konten_Thumbnail {
  id             Int           @id @default(autoincrement())
  kajianKontenId String        @unique @map("kajian_konten_id") @db.VarChar(100)
  kajianKonten   Kajian_Konten @relation(fields: [kajianKontenId], references: [id], onDelete: Cascade)
  nama           String        @db.VarChar(250)
  path           String        @db.Text

  createdAt DateTime  @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt DateTime? @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime

  @@map("kajian_konten_thumbnail")
}

model Live {
  id      String   @id @db.VarChar(150)
  userId  String   @map("user_id") @db.VarChar(150)
  user    User     @relation(fields: [userId], references: [id])
  judul   String   @db.VarChar(100)
  link    String   @db.Text
  mulai   DateTime
  selesai DateTime

  createdAt DateTime        @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt DateTime?       @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime
  thumbnail Live_Thumbnail?

  @@map("live")
}

model Live_Thumbnail {
  id     Int    @id @default(autoincrement())
  liveId String @unique @map("live_id") @db.VarChar(150)
  live   Live   @relation(fields: [liveId], references: [id], onDelete: Cascade)
  nama   String @db.VarChar(250)
  path   String @db.Text

  createdAt DateTime  @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt DateTime? @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime

  @@map("live_thumbnail")
}

model Podcast {
  id       String @id @db.VarChar(150)
  userId   String @map("user_id") @db.VarChar(150)
  user     User   @relation(fields: [userId], references: [id])
  judul    String @db.VarChar(100)
  captions String @db.Text

  createdAt DateTime           @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt DateTime?          @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime
  thumbnail Podcast_Thumbnail?
  video     Podcast_Video?

  @@map("podcast")
}

model Podcast_Thumbnail {
  id        Int     @id @default(autoincrement())
  podcastId String  @unique @map("podcast_id") @db.VarChar(150)
  podcast   Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  nama      String  @db.VarChar(250)
  path      String  @db.Text

  createdAt DateTime  @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt DateTime? @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime

  @@map("podcast_thumbnail")
}

model Podcast_Video {
  id        Int     @id @default(autoincrement())
  podcastId String  @unique @map("podcast_id") @db.VarChar(150)
  podcast   Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  nama      String  @db.VarChar(250)
  path      String  @db.Text

  createdAt DateTime  @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt DateTime? @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime

  @@map("podcast_video")
}

model Kas {
  id           String @id @db.VarChar(150)
  mesjidUserId String @map("mesjid_user_id")
  mesjid       Mesjid @relation(fields: [mesjidUserId], references: [userId], onDelete: Cascade)
  nama         String @db.VarChar(200)
  saldo        BigInt @default(0) @db.BigInt

  createdAt    DateTime     @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt    DateTime?    @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime
  kasBank      Kas_Bank?
  kasArus      Kas_Arus[]
  kasSender    Kas_Mutasi[] @relation("kasSender")
  kasRecipient Kas_Mutasi[] @relation("kasRecipient")

  @@map("kas")
}

model Kas_Bank {
  id         Int       @id @default(autoincrement())
  kasId      String    @unique @map("kas_id")
  kas        Kas       @relation(fields: [kasId], references: [id], onDelete: Cascade)
  userBankId Int       @unique @map("user_bank_id")
  userBank   User_Bank @relation(fields: [userBankId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt DateTime? @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime

  @@map("kas_bank")
}

model Kas_Arus {
  id         Int    @id @default(autoincrement())
  kasId      String @map("kas_id")
  kas        Kas    @relation(fields: [kasId], references: [id], onDelete: Cascade)
  tipe       String @db.VarChar(10)
  jumlah     Int    @db.Int
  kategori   String @db.VarChar(30)
  metode     String @db.VarChar(50)
  keterangan String @db.Text

  createdAt      DateTime          @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt      DateTime?         @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime
  kasArusDokumen Kas_Arus_Dokumen?

  @@map("kas_arus")
}

model Kas_Arus_Dokumen {
  id        Int      @id @default(autoincrement())
  kasArusId Int      @unique @map("kas_arus_detail_id")
  kasArus   Kas_Arus @relation(fields: [kasArusId], references: [id], onDelete: Cascade)
  nama      String   @db.VarChar(250)
  path      String   @db.Text

  createdAt DateTime  @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt DateTime? @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime

  @@map("kas_arus_dokumen")
}

model Kas_Mutasi {
  id             Int    @id @default(autoincrement())
  jumlah         BigInt @db.BigInt
  mesjidUserId   String @map("mesjid_user_id")
  mesjid         Mesjid @relation(fields: [mesjidUserId], references: [userId], onDelete: Cascade)
  kasSenderId    String @map("kas_sender_Id") @db.VarChar(150)
  kasSender      Kas    @relation("kasSender", fields: [kasSenderId], references: [id], onDelete: Cascade)
  kasRecipientId String @map("kas_recipient_Id") @db.VarChar(150)
  kasRecipient   Kas    @relation("kasRecipient", fields: [kasRecipientId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt DateTime? @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime

  @@map("kas_mutasi")
}

model Bank {
  id   Int    @id @default(autoincrement())
  kode String @unique @db.VarChar(100)
  nama String @db.VarChar(150)

  createdAt DateTime    @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt DateTime?   @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime
  userBank  User_Bank[]

  @@map("bank")
}

model Surah {
  id        Int    @id @default(autoincrement())
  namaSurah String @map("nama_surah") @db.VarChar(100)
  ayat      Ayat[]

  @@map("surah")
}

model Ayat {
  id         Int    @id @default(autoincrement())
  surahId    Int    @map("surah_id") @db.Int()
  surah      Surah  @relation(fields: [surahId], references: [id])
  nomorAyat  Int    @map("nomor_ayat") @db.Int()
  teksArab   String @map("teks_arab") @db.Text
  terjemahan String @db.Text
  teksLatin  String @map("teks_latin") @db.Text

  @@map("ayat")
}

model List_Categories {
  id                   Int                     @id @default(autoincrement())
  nama                 String                  @db.VarChar(100)
  createdAt            DateTime                @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt            DateTime?               @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime
  midtransTransactions Midtrans_Transactions[]

  @@map("list_categories")
}

model Midtrans_Transactions {
  id              String            @id @db.VarChar(150)
  recipientId     String            @map("recipient_id") @db.VarChar(150)
  recipient       User              @relation("recipient", fields: [recipientId], references: [id])
  categoryId      Int               @map("category_id") @db.Int
  category        List_Categories   @relation(fields: [categoryId], references: [id])
  amount          Int               @db.Int
  netAmount       Int               @default(0) @map("net_amount") @db.Int
  redirectUrl     String            @map("redirect_url") @db.VarChar(150)
  isInserted      Boolean           @default(false) @map("is_inserted")
  createdAt       DateTime          @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt       DateTime?         @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime
  userInfaq       User_Infaq?
  userSedekah     User_Sedekah?
  transaksiMesjid Transaksi_Mesjid?

  @@map("midtrans_transactions")
}

model Infaq {
  id            String         @id @db.VarChar(150)
  mesjidUserId  String         @map("mesjid_user_id") @db.VarChar(150)
  mesjid        Mesjid         @relation(fields: [mesjidUserId], references: [userId])
  uraian        String         @db.Text
  targetNominal BigInt         @map("target_nominal") @db.BigInt
  saldoMasuk    BigInt         @default(0) @map("saldo_masuk") @db.BigInt
  foto          String         @db.VarChar(150)
  path          String         @db.VarChar(150)
  createdAt     DateTime       @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt     DateTime?      @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime
  infaqTarget   Infaq_Target[]

  @@map("infaq")
}

model User_Infaq {
  id          Int                   @id @default(autoincrement())
  midtransId  String                @unique @map("midtrans_id") @db.VarChar(150)
  midtrans    Midtrans_Transactions @relation(fields: [midtransId], references: [id], onDelete: Cascade)
  userId      String                @map("user_id") @db.VarChar(150)
  user        User                  @relation(fields: [userId], references: [id])
  pesan       String?               @db.Text
  createdAt   DateTime              @default(dbgenerated("NOW()")) @map("created_at") @db.DateTime
  updatedAt   DateTime?             @default(dbgenerated("NOW() ON UPDATE NOW()")) @map("updated_at") @db.DateTime
  infaqTarget Infaq_Target?

  @@map("user_infaq")
}

model Infaq_Target {
  userInfaqId Int        @unique @map("user_infaq_id") @db.Int
  userInfaq   User_Infaq @relation(fields: [userInfaqId], references: [id], onDelete: Cascade)
  infaqId     String     @map("infaq_id") @db.VarChar(150)
  infaq       Infaq      @relation(fields: [infaqId], references: [id], onDelete: Cascade)

  @@id([userInfaqId, infaqId])
  @@map("infaq_target")
}

